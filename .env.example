# Sao chép thành .env cho môi trường dev/demo (docker compose đọc tự động). .env đã nằm trong .gitignore.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_AUTH_ENABLED=false

# Cổng host của nginx
NGINX_HTTP_PORT=8080
NGINX_HTTPS_PORT=8443

# URL công khai (qua tunnel nếu có): build vào frontend, link email, auth
PUBLIC_SITE_URL=https://localhost

# Basic auth cho https://<site>/hangfire. Để trống => dashboard trả 401 (trừ khi đăng nhập admin).
HANGFIRE_DASHBOARD_USERNAME=admin
HANGFIRE_DASHBOARD_PASSWORD=
