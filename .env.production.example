# Sao chép thành .env.production rồi điền giá trị thật. File .env.production đã nằm trong .gitignore.
PUBLIC_SITE_URL=https://culinary.example.com
POSTGRES_PASSWORD=
JWT_KEY=            # >= 32 ký tự ngẫu nhiên, đổi định kỳ (~90 ngày)
AUTH_SECRET=        # chuỗi ngẫu nhiên dài cho Auth.js
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@culinary.example.com
# Basic auth cho https://<site>/hangfire (bắt buộc ở production; để trống => dashboard trả 401)
HANGFIRE_DASHBOARD_USERNAME=
HANGFIRE_DASHBOARD_PASSWORD=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_AUTH_ENABLED=false
