# Copy file này thành .env.local rồi chỉnh theo máy của bạn. KHÔNG commit .env.local.

# URL backend API (không có dấu "/" ở cuối). Dùng cho cả trình duyệt và server.
NEXT_PUBLIC_API_URL=http://localhost:5000

# URL backend khi gọi từ server Next.js (SSR/ISR), ví dụ trong Docker: http://api:5000.
# Bỏ trống thì dùng NEXT_PUBLIC_API_URL.
API_URL=

# URL public của trang web, dùng cho SEO (canonical, Open Graph, JSON-LD).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
