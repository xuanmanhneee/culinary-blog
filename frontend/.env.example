# Copy file này thành .env.local rồi chỉnh theo máy của bạn. KHÔNG commit .env.local.

# URL backend API (không có dấu "/" ở cuối). Dùng cho cả trình duyệt và server.
NEXT_PUBLIC_API_URL=http://localhost:5000

# URL backend khi gọi từ server Next.js (SSR/ISR), ví dụ trong Docker: http://api:8080.
API_URL=http://localhost:5000

# Có thể override tiền tố API server-side; nếu bỏ trống sẽ ghép API_URL với /api/v1.
API_V1=http://localhost:5000/api/v1

# URL public của trang web, dùng cho SEO (canonical, Open Graph, JSON-LD).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Auth.js v5 (next-auth) phía frontend ---
# Khóa dùng để ký JWT session; sinh bằng: openssl rand -base64 32
AUTH_SECRET=

# Đăng nhập Google (FR-AUTH-003). Bỏ trống nếu chưa cấu hình OAuth.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Bật nút Google sau khi hai biến trên và backend Google:ClientId đã được cấu hình.
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false
